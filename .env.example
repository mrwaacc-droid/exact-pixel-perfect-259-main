# ══════════════════════════════════════════════════════════════════
# Klassruum — environment variables
#
# Copy this file to `.env.local` and fill in real values. `.env.local`
# is gitignored — never commit real secrets.
#
# Vars prefixed VITE_ are PUBLIC: they ship to the browser bundle.
# Never put a secret in a VITE_ variable.
# ══════════════════════════════════════════════════════════════════

# ── App URL / environment ────────────────────────────────────────
NODE_ENV=development
# Canonical origin used by invite/auth/billing callback links.
APP_URL=http://localhost:3000
# Optional aliases some server helpers also check (same precedence
# order as APP_URL unless noted otherwise below).
PUBLIC_APP_URL=http://localhost:3000
VITE_APP_URL=http://localhost:3000
# Cosmetic only — shown in the platform admin dashboard, not read
# by any functional code path.
APP_REGION=

# ── Demo mode ─────────────────────────────────────────────────────
# Demo mode is allowed by default only in local development.
# Set these explicitly in non-dev environments if you intentionally
# want demo behavior.
ALLOW_DEMO_MODE=false
VITE_ALLOW_DEMO_MODE=false
# Cosmetic only — shown in the admin dashboard, not enforced as an
# actual gate anywhere in the app.
MAINTENANCE_MODE=false

# ── Public self-registration / security ─────────────────────────
# Set PUBLIC_REGISTRATION_ENABLED=false to close institution self-registration.
PUBLIC_REGISTRATION_ENABLED=true
# Required in production when public registration is enabled (Cloudflare Turnstile).
TURNSTILE_SECRET_KEY=
VITE_TURNSTILE_SITE_KEY=
# Shared secret for the session-lifecycle cron endpoint
# (src/routes/api.cron.session-lifecycle.ts). Falls back to a hardcoded
# dev value if unset — set a real value in production.
CRON_SECRET=
VITE_CRON_SECRET=

# ── Supabase core configuration ─────────────────────────────────
# Preferred names used by server-only code.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional backward-compatible alias used by some storage helpers.
SUPABASE_SERVICE_KEY=

# Client-side Vite variables (preferred in the browser bundle).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Backward-compatible aliases also supported by parts of the app.
SUPABASE_ANON_KEY=
VITE_SUPABASE_ANON_KEY=

# ── Google OAuth ("Continue with Google") ────────────────────────
# Consumed locally by supabase/config.toml's [auth.external.google] block
# (for `supabase start`). For the hosted project, the same values must
# ALSO be set in Supabase Dashboard → Authentication → Sign In / Providers
# → Google — config.toml does not push to production.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── AI providers ──────────────────────────────────────────────────
# OpenAI — only these 3 models are used anywhere in the app right now:
# gpt-4o-mini (teacher answers / lesson generation), gpt-5-nano (fast
# interactive turns / adaptive intervention), gpt-4.1-nano (sentiment).
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
# DeepSeek — always uses deepseek-v4-flash for every purpose.
# Get a key at https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
# Cosmetic only — shown in the platform admin AI settings panel, not
# actually read by the AI gateway (model/base URL are hardcoded there).
OPENAI_MODEL=
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_MODEL=
AI_DEFAULT_PROVIDER=
AI_MAX_TOKENS=

# ── Image sourcing for lesson illustrations (Pexels) ─────────────
# Required for lesson generation to attach real photo illustrations.
# Free key: https://www.pexels.com/api/
PEXELS_API_KEY=

# ── Institution billing / monthly classroom rental (Paystack) ────
# Required for Paystack checkout, payment verification, and monthly plans.
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
# Cosmetic only — shown in the admin dashboard; actual currency is
# set per-transaction in the billing code.
PLATFORM_CURRENCY=

# ── Outbound email (Resend, via Supabase Edge Function) ─────────
# The app sends mail by POSTing to the "send-email" Supabase Edge Function
# (supabase/functions/send-email), which holds the Resend API key as its
# own Supabase secret (RESEND_API_KEY / EMAIL_FUNCTION_BEARER — set with
# `supabase secrets set`, never stored here or in app env).
# URL is https://<project-ref>.supabase.co/functions/v1/send-email
SUPABASE_EMAIL_FUNCTION_URL=
# Must match the EMAIL_FUNCTION_BEARER secret set on the edge function.
SUPABASE_EMAIL_FUNCTION_BEARER=

# ── Email template contact details (optional) ────────────────────
# Shown in the footer of every branded transactional email. Any of these
# left blank are simply omitted from the email — no placeholder text is
# ever sent to real recipients.
BRAND_SUPPORT_PHONE=
BRAND_ADDRESS=
BRAND_TWITTER_URL=
BRAND_LINKEDIN_URL=
BRAND_INSTAGRAM_URL=
BRAND_FACEBOOK_URL=

# ── Local TTS (Kokoro / Piper fallback) ──────────────────────────
LOCAL_TTS_SECRET=dev-secret
LOCAL_KOKORO_TTS_URL=http://localhost:8008
LOCAL_PIPER_TTS_URL=http://localhost:8008

# ── ElevenLabs TTS (premium — used as primary provider) ──────────
# Sign up at https://elevenlabs.io and get your API key from Profile → API Keys.
# When this key is set, all teacher voices will use ElevenLabs for natural,
# human-quality speech. Without it, the system falls back to local TTS.
ELEVENLABS_API_KEY=
# Model: eleven_multilingual_v2 (best quality) or eleven_turbo_v2_5 (faster)
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# Signing secret for the ElevenLabs webhook endpoint (src/routes/api.elevenlabs-webhook.ts).
# Get this from the ElevenLabs dashboard after creating the webhook endpoint
# (Settings/Webhooks -> Add Endpoint) — shown once the endpoint is created.
ELEVENLABS_WEBHOOK_SECRET=
# Cosmetic only — shown in the admin dashboard; actual provider
# selection happens per-request in the TTS provider code.
TEACHER_VOICE_ENABLED=
TEACHER_VOICE_PROVIDER=
TEACHER_VOICE_VOICE=
